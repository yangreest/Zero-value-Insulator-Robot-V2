    border-right: none;
}

/* 表格单元格 */
QTableWidget::item {
    padding: 4px;
}

/* 单元格悬浮 */
QTableWidget::item:hover {
    background-color: #1a243a;
}

/* 滚动条配套（可选，深色界面必备） */
