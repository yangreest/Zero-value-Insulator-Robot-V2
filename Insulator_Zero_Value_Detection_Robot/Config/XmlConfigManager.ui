      <property name="styleSheet">
       <string notr="true">/* ========== 新增/优化：QListWidget 样式 ========== */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d6e0;
    border-radius: 4px;
    padding: 4px;
    color: #333842;
    outline: none; /* 去除选中时的虚线框 */
}

/* 列表项基础样式 */
QListWidget::item {
    padding: 8px 10px;
    border-radius: 3px;
    margin: 2px 0;
}

/* 列表项悬浮效果 */
QListWidget::item:hover {
    background-color: #e6f0ff;
}

/* 列表项选中效果 */
QListWidget::item:selected {
    background-color: #1e6ceb;
    color: #ffffff;
}

/* 列表项禁用效果（如需） */
QListWidget::item:disabled {
    color: #a0a6b3;
    background-color: #f8f9fc;
}</string>
